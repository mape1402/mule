<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Mule.DurableActions.Redis</PackageId>
    <Title>Mule Durable Actions Redis Storage</Title>
    <PackageType>Dependency</PackageType>
    <Description>Redis-backed authoritative durable storage for Mule actions, retries, cancellation, replay, cleanup, and multi-replica recovery.</Description>
    <PackageTags>$(PackageTags);redis;storage;distributed;leases;recovery</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="2.8.24" />
    <ProjectReference Include="..\Mule\Mule.csproj" />
  </ItemGroup>

</Project>
